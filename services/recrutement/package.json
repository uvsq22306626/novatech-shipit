{
  "name": "@hrflow/recrutement",
  "version": "0.1.0",
  "dependencies": {
    "express": "^4.18.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jest": "^29.0.0",
    "supertest": "^6.3.0",
    "nyc": "^15.1.0",
    "cross-env": "^7.0.3",
    "wait-on": "^7.0.1"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:cov": "cross-env MOCK_DB=true nyc --reporter=lcov --reporter=text node src/index.js",
    "dev": "nodemon src/index.js",
    "test:unit": "jest --coverage",
    "test:e2e": "cross-env MOCK_DB=true playwright test e2e",
    "test:merge": "npx nyc merge .nyc_output coverage/merged.json && npx nyc report --reporter=text-summary --temp-dir=coverage --report-dir=coverage",
    "test:all": "npm run test:unit && npm run start:cov & wait-on http://localhost:3004 && npm run test:e2e && npm run test:merge",
    "test": "npm run test:unit",
    "test:coverage": "jest --coverage",
    "report": "npx nyc report --reporter=lcov --reporter=text-summary"
  },
  "nyc": {
    "include": ["src/**/*.js"],
    "exclude": ["**/tests/**", "e2e/**"],
    "reporter": ["text", "lcov"],
    "all": true
  }
}
