# HRFlow — variables d'environnement pour docker-compose (local uniquement)
# Copier ce fichier en .env puis remplir avec des valeurs de dev (jamais de vrais secrets).

# --- Base de données PostgreSQL ---
# Utilisé à la fois pour initialiser le conteneur postgres (POSTGRES_DB/USER/PASSWORD)
# et pour construire DATABASE_URL / DB_* passés aux services (auth, paie, conges, recrutement).
DB_NAME=hrflow
DB_USER=hrflow
DB_PASSWORD=hrflow_dev_password

# --- Auth / API Gateway ---
# Doit être identique entre "auth" (qui signe les tokens) et "api-gateway" (qui les vérifie).
JWT_SECRET=dev_jwt_secret_change_me

# Origines autorisées en CORS par l'api-gateway (liste séparée par des virgules)
ALLOWED_ORIGINS=http://localhost:5173

# --- Service paie ---
# Clé Stripe factice pour le développement local (l'appel est déjà catché en cas d'échec)
STRIPE_SECRET_KEY=sk_test_dummy

# --- Service recrutement ---
# Passer à "true" pour utiliser les réponses mockées au lieu de PostgreSQL
MOCK_DB=false

# --- Général ---
NODE_ENV=development
